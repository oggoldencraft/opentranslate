{
  "name": "opentranslate",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "OpenTranslate — local-first Material 3 translation web app powered by Ollama (kaelri/qwen3.5-mt:2b)",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node server/proxy.mjs --host 0.0.0.0",
    "start:lan": "npm run build && node server/proxy.mjs --host 0.0.0.0",
    "proxy": "node server/proxy.mjs --host 0.0.0.0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@material/material-color-utilities": "^0.4.0",
    "@material/web": "^2.5.0",
    "@tesseract.js-data/deu": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/rus": "^1.0.0",
    "@tesseract.js-data/ukr": "^1.0.0",
    "lit": "^3.3.3",
    "mammoth": "^1.13.0",
    "material-symbols": "^0.49.0",
    "pdfjs-dist": "^5.4.624",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "happy-dom": "^21.0.4",
    "typescript": "~5.9.3",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  }
}
